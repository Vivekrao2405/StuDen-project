# Every env var this app reads (see application.yml). Copy to .env and fill in real values --
# never commit a real .env.

# Must exactly match EXECUTION_SERVER_API_KEY on the main backend
# (backend/.env.example / Render's env vars). Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Blank means every /compile and /run request is rejected (fails closed) -- /health stays open.
EXECUTION_API_KEY=

# The one image every sandbox container runs. Build it once on this host from the main repo:
#   docker build -t studen-code-runner:latest backend/docker/runner
RUNNER_IMAGE=studen-code-runner:latest

# The port this app listens on (also the left side of docker-compose.yml's port mapping).
SERVER_PORT=8081

# REQUIRED, no default: an absolute path on the HOST machine (not inside any container) where
# per-submission workspaces (source + compiled artifact) live while a submission is being
# compiled/run. docker-compose.yml bind-mounts this same path into the execution-server container
# at /workspaces AND is what the execution-server passes to the host Docker daemon when
# bind-mounting a workspace into each ephemeral studen-code-runner sandbox container -- see
# docker-compose.yml's comment on this ("DooD path-mapping"). Must be writable by Docker.
# Example: /home/studen/execution-workspaces
WORKSPACE_HOST_PATH=

# How long (seconds) an idle workspace is kept on disk after the last compile()/run() call before
# WorkspaceCleanupTask deletes it. 180 is generous above the worst-case compile-timeout plus
# (test-case-count * run-timeout) for any realistic assessment; raise it only if you see workspaces
# expiring mid-attempt in the logs.
WORKSPACE_TTL_SECONDS=180

# Advanced / rarely needed -- leave blank to use docker-java's own default resolution (its own
# reading of the real DOCKER_HOST env var, or the platform default local socket). Only set these
# if this app talks to a non-default or remote Docker Engine (e.g. TCP with TLS).
EXECUTION_DOCKER_HOST=
EXECUTION_DOCKER_TLS_VERIFY=false
EXECUTION_DOCKER_CERT_PATH=
