SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=studen_db
DB_USERNAME=studen_user
DB_PASSWORD=changeme

# JWT — generate a long random secret (e.g. 64 random bytes, base64-encoded). Never commit the
# real value, and never let it change between deploys/restarts — a rotated secret invalidates
# every existing access token and refresh-token session simultaneously.
JWT_SECRET=changeme-generate-a-long-random-base64-secret
# Access token lifetime, ms. Short on purpose (15 min) — the frontend silently exchanges an
# expired one for a new one via POST /api/v1/auth/refresh, so this only bounds how long a leaked
# access token stays usable, not how long the user stays logged in.
JWT_EXPIRATION_MS=900000
# Refresh token lifetime, ms. Long-lived (30 days) and sliding — every successful /refresh call
# rotates and re-extends it, so a user who opens the app at least once a month stays logged in
# indefinitely without ever seeing the login screen again.
JWT_REFRESH_EXPIRATION_MS=2592000000

# CORS — frontend origin(s) allowed to call this API with credentials.
# One origin, or a comma-separated list, e.g.:
# CORS_ALLOWED_ORIGIN=http://localhost:5173,https://studen.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ADMIN_BOOTSTRAP_EMAIL — the account promoted to ADMIN on every backend startup (see
# AdminBootstrapRunner), gating Question Bank management access. Blank/unset = no auto-promotion,
# and no user is ever ADMIN by default. Set to an account you can log into.
ADMIN_BOOTSTRAP_EMAIL=

# PUBLIC_PROFILE_BASE_URL — base URL used to build public profile links
# (e.g. https://studen.app/u). Defaults to a placeholder; set to the real
# deployed frontend origin + /u in production.
PUBLIC_PROFILE_BASE_URL=https://studen.app/u

# Cloudinary — persistent image storage for cover-image uploads. Create a free
# account at https://cloudinary.com and copy these three values from its
# dashboard. Never commit real values here or anywhere else in the repo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MAX_IMAGE_SIZE_MB — largest cover image accepted by the upload endpoint, in
# megabytes. Defaults to 5, which comfortably covers an unoptimized phone
# photo without allowing large uploads.
MAX_IMAGE_SIZE_MB=5

# JPA_SHOW_SQL — logs every generated SQL statement. Defaults to false (off).
# Set to true locally when debugging query counts/N+1s; never enable in production.
JPA_SHOW_SQL=false

# VAPID keypair — authenticates this backend to browser push services (Web Push protocol,
# RFC 8292). Generate once with `npx web-push generate-vapid-keys` and store here. No default:
# a missing key must fail startup loudly, not silently send broken/unauthenticated push
# requests. VAPID_PRIVATE_KEY must never be exposed to the frontend, logged, or committed —
# only VAPID_PUBLIC_KEY is ever sent to the browser (via GET /api/v1/push/vapid-public-key) for
# PushManager.subscribe()'s applicationServerKey.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@studen.app

# Resend — email delivery for the Admin Communications Center
# (com.studen.communication.email.ResendEmailService). RESEND_API_KEY is backend-only: never
# sent to the frontend, never logged, never stored in the database. No defaults, deliberately —
# a missing value must stop the app from starting rather than silently no-op every campaign
# email. Create an account at https://resend.com, generate an API key, and (before sending to
# real students) verify a sending domain there; during development EMAIL_FROM can use Resend's
# own sandbox sender (onboarding@resend.dev) without any domain verification.
RESEND_API_KEY=
EMAIL_FROM=
# Signing secret for the Resend webhook (dashboard/webhooks/verify-webhooks-requests) — verified
# per-request in ResendWebhookController via ResendWebhookVerifier before any event is trusted.
# Only needed if you configure a webhook endpoint in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Code execution provider for practical coding assessments (Run/Check + Submit).
# "docker" (default) requires a local Docker Engine + the studen-code-runner image (see
# backend/docker/runner/) -- fine for local dev, NOT available on Render (no Docker access there).
# Set EXECUTION_PROVIDER=remote in production/Render (and optionally locally too, to exercise the
# exact same code path as prod) and configure the two EXECUTION_SERVER_* values below to point at
# a running instance of the separate execution-server/ app (see execution-server/.env.example and
# execution-server/README for how to stand one up).
EXECUTION_PROVIDER=docker

# The self-hosted execution-server (com.studen.practical.judge.RemoteCodeExecutionService) — the
# production code-execution provider. EXECUTION_SERVER_API_KEY must exactly match EXECUTION_API_KEY
# configured on the execution-server itself. Defaults to empty, deliberately: a missing key just
# makes RemoteCodeExecutionService report unavailable (503 on Run/Check) rather than failing the
# whole app's startup -- only relevant if EXECUTION_PROVIDER=remote. Never commit a real key.
EXECUTION_SERVER_URL=
EXECUTION_SERVER_API_KEY=
