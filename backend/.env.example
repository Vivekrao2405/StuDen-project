SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=studen_db
DB_USERNAME=studen_user
DB_PASSWORD=changeme

# JWT — generate a long random secret (e.g. 64 random bytes, base64-encoded). Never commit the real value.
JWT_SECRET=changeme-generate-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

# CORS — frontend origin(s) allowed to call this API with credentials.
# One origin, or a comma-separated list, e.g.:
# CORS_ALLOWED_ORIGIN=http://localhost:5173,https://studen.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:5173

# PUBLIC_PROFILE_BASE_URL — base URL used to build public profile links
# (e.g. https://studen.app/u). Defaults to a placeholder; set to the real
# deployed frontend origin + /u in production.
PUBLIC_PROFILE_BASE_URL=https://studen.app/u

# Cloudinary — persistent image storage for cover-image uploads. Create a free
# account at https://cloudinary.com and copy these three values from its
# dashboard. Never commit real values here or anywhere else in the repo.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# MAX_IMAGE_SIZE_MB — largest cover image accepted by the upload endpoint, in
# megabytes. Defaults to 5, which comfortably covers an unoptimized phone
# photo without allowing large uploads.
MAX_IMAGE_SIZE_MB=5

# JPA_SHOW_SQL — logs every generated SQL statement. Defaults to false (off).
# Set to true locally when debugging query counts/N+1s; never enable in production.
JPA_SHOW_SQL=false
